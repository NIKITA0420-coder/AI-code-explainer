9. Kotlin
kotlin
fun main() {
    try {
        val arr = arrayOf(1, 2, 3)
        println(arr[10])
    } catch (e: ArrayIndexOutOfBoundsException) {
        println("Error: ${e.message}")
        e.printStackTrace()
    } finally {
